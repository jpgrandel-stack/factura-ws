# Copia este archivo a ".env" y llena tus valores reales.
# Nunca subas el archivo ".env" real a GitHub.

# Los encuentras en console.twilio.com, en el Account Dashboard (Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Tu clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto local (Render/Railway lo asignan automáticamente en producción)
PORT=3000
